root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,xml,csproj,props,slnx,plist,template,ts,vue,css,html,yml,yaml}]
indent_size = 2

[*.{sh,zsh}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

[**/Migrations/*.cs]
generated_code = true
