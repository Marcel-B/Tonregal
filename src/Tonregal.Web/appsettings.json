{
  "Tonregal": {
    "MusicRoot": "/Volumes/T7/Musik",
    "Metadata": {
      "FpcalcPath": "fpcalc",
      "AcoustIdApiKey": ""
    },
    "Analysis": {
      "RsgainPath": "rsgain",
      "RunAtNight": true,
      "NightStart": "01:00",
      "NightEnd": "06:00"
    },
    "Backup": {
      "Enabled": true,
      "RclonePath": "rclone",
      "Remote": "nextcloud:Musik",
      "Time": "03:00",
      "KeepStateDays": 7,
      "MaxDelete": 500
    },
    "Ingest": {
      "Keys": {}
    },
    "Navidrome": {
      "Url": "",
      "User": "",
      "Password": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
