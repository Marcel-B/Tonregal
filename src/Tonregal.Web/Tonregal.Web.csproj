<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <ClientAppRoot>ClientApp/</ClientAppRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tonregal.Infrastructure\Tonregal.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Grafana.Loki" />
    <PackageReference Include="prometheus-net.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="$(ClientAppRoot)**" />
    <None Remove="$(ClientAppRoot)**" />
    <None Include="$(ClientAppRoot)**" Exclude="$(ClientAppRoot)node_modules/**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="analysis/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Beim Publish die Vue-SPA bauen; Vite schreibt nach wwwroot. Das muss vor dem Build passieren,
       damit die Static-Web-Assets (inkl. Kompression) die neuen, gehashten Dateien sehen und nicht
       die vom letzten Build. -->
  <Target Name="BuildClientApp" BeforeTargets="BeforeBuild" Condition="'$(_IsPublishing)' == 'true' And '$(SkipClientApp)' != 'true'">
    <Exec WorkingDirectory="$(ClientAppRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(ClientAppRoot)" Command="npm run build" />
    <!-- wwwroot wurde bei der Auswertung des Projekts noch mit dem alten Stand eingelesen. Ein Remove mit
         Platzhalter würde im Target gegen die Platte aufgelöst und die von Vite gelöschten Dateien gerade
         nicht treffen, deshalb über die Items selbst. -->
    <ItemGroup>
      <_StaleWwwroot Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Replace('\','/').StartsWith('wwwroot/'))" />
      <Content Remove="@(_StaleWwwroot)" />
      <Content Include="wwwroot/**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
